{
	email {$ACME_EMAIL}

	admin 0.0.0.0:{$PORT_CADDY_ADMIN}

	dynamic_dns {
		provider duckdns {$DUCKDNS_TOKEN}
		domains {
			{$DUCKDNS_ZONE} {$DUCKDNS_SUBDOMAIN}
		}
		versions ipv4
		check_interval 5m
	}
}

(common) {
	encode zstd gzip
	log {
		output file /var/log/caddy/access.log
	}
}

heimdall.{$DUCKDNS_SUBDOMAIN}.{$DUCKDNS_ZONE} {
	import common
	reverse_proxy {$CADDY_HOST_ALIAS}:{$PORT_HEIMDALL_HTTP}
}

beszel.{$DUCKDNS_SUBDOMAIN}.{$DUCKDNS_ZONE} {
	import common
	reverse_proxy {$CADDY_HOST_ALIAS}:{$PORT_BESZEL_HTTP}
}

nextcloud.{$DUCKDNS_SUBDOMAIN}.{$DUCKDNS_ZONE} {
	import common

	# Service discovery endpoints Nextcloud's setup checks require.
	redir /.well-known/carddav /remote.php/dav 301
	redir /.well-known/caldav /remote.php/dav 301

	reverse_proxy {$CADDY_HOST_ALIAS}:{$PORT_NEXTCLOUD_HTTP}
}

sonarr.{$DUCKDNS_SUBDOMAIN}.{$DUCKDNS_ZONE} {
	import common
	reverse_proxy {$CADDY_HOST_ALIAS}:{$PORT_SONARR_HTTP}
}

qbittorrent.{$DUCKDNS_SUBDOMAIN}.{$DUCKDNS_ZONE} {
	import common
	reverse_proxy {$CADDY_HOST_ALIAS}:{$PORT_QBITTORRENT_HTTP}
}

radarr.{$DUCKDNS_SUBDOMAIN}.{$DUCKDNS_ZONE} {
	import common
	reverse_proxy {$CADDY_HOST_ALIAS}:{$PORT_RADARR_HTTP}
}

komodo.{$DUCKDNS_SUBDOMAIN}.{$DUCKDNS_ZONE} {
	import common
	reverse_proxy {$CADDY_HOST_ALIAS}:{$PORT_KOMODO_HTTP}
}

immich.{$DUCKDNS_SUBDOMAIN}.{$DUCKDNS_ZONE} {
	import common
	reverse_proxy {$CADDY_HOST_ALIAS}:{$PORT_IMMICH_HTTP}
}

# Catch-all for hosts we do not serve, such as the bare public IP and the ISP
# reverse-DNS name. Scanners hit these constantly; close the connection instead
# of answering with a redirect. Host-specific sites above still take precedence,
# and Caddy's ACME challenge handler runs ahead of these routes.
:80 {
	abort
}

:443 {
	abort
}
